# Contact form API endpoints. Point at your taptech-crm-app deployment.
# Production:  https://api-crm.taptech.net
# Local dev:   http://localhost:8080

# Where the form POSTs the Lead. Unset = log to console (dev fallback).
JAICLAW_CONTACT_API_URL=

# Captcha endpoint base URL (usually same origin as the contact API).
# When set, the contact form fetches GET /captcha to mint an id+image, then
# submits id + user answer alongside the form payload. Unset = no captcha UI
# (use when server-side TAPTECH_CRM_PROTECT_CAPTCHA_ENABLED=false).
JAICLAW_CAPTCHA_URL=

# Submission-token mint endpoint base URL (usually same origin as above).
# When set and FEATURE_SUBMISSION_TOKEN=true, the form fetches a single-use
# token from GET /forms/leads/token on mount and sends it as X-Submission-Token
# on POST. Unset = no token, no header (server must be configured to allow it).
JAICLAW_TOKEN_API_URL=

# Feature flags
# FEATURE_PRICING is default-OFF: only 'true'/'1' enables it (hide /pricing in nav).
JAICLAW_FEATURE_PRICING=false

# FEATURE_SUBMISSION_TOKEN is default-ON: only 'false'/'0' disables it.
# Security feature flags default to on; disable only for local dev against a
# server with taptech.crm.protect.submission-token.enabled=false.
JAICLAW_FEATURE_SUBMISSION_TOKEN=true
